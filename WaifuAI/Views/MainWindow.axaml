<Window
    x:Class="WaifuAI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WaifuAI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Animated"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WaifuAI.Models"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:views="using:WaifuAI.Views"
    xmlns:vm="using:WaifuAI.ViewModels"
    xmlns:wv="clr-namespace:WebViewControl;assembly=WebViewControl.Avalonia"
    xmlns:translations="clr-namespace:WaifuAI.Translations;assembly=WaifuAI.Translations"
    xmlns:echoes="clr-namespace:Echoes;assembly=Echoes.Avalonia"
    xmlns:custom="using:WaifuAI.CustomClasses"
    Title="WaifuAI"
    d:DesignHeight="720"
    d:DesignWidth="1024"
    x:DataType="vm:MainVM"
    Closed="Window_Closed"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="40"
    ExtendClientAreaToDecorationsHint="True"
    FontFamily="{Binding SelectedFontFamily, Source={x:Static vm:SettingsVM.Instance}}"
    Icon="/Assets/icon.ico"
    Loaded="Window_OnLoaded"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:StringValueConverter x:Key="StringValueConverter" />
        <conv:BoolToSelectionModeConverter x:Key="BoolToSelectionModeConverter" />
        <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
            <Setter Property="DefaultFocusAdorner">
                <FocusAdornerTemplate>
                    <Border
                        Margin="{DynamicResource SystemControlFocusVisualMargin}"
                        BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}"
                        BorderThickness="3"
                        CornerRadius="4">
                        <Border
                            BorderBrush="{DynamicResource SystemBaseLowColor}"
                            BorderThickness="0"
                            CornerRadius="4" />
                    </Border>
                </FocusAdornerTemplate>
            </Setter>
        </ControlTheme>
        <sys:Double x:Key="SettingsPopupEdgeWidth">680</sys:Double>
        <sys:Double x:Key="TopPanelEdgeWidth">740</sys:Double>

    </Window.Resources>
    <Grid
        x:Name="RootPanel"
        Margin="{Binding $parent[Window].OffScreenMargin}"
        Background="{DynamicResource Scroll}"
        Focusable="True"
        PointerPressed="OnBackgroundPointerPressed">
        <Grid.Styles>

            <Style Selector="TextBlock:disabled">
                <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumLowColor}" />
            </Style>

            <Style Selector="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            </Style>

            <Style Selector="ListBox">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
            </Style>

            <Style Selector="Button.icon-button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Cursor" Value="Hand" />
                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                </Style>
            </Style>

            <Style Selector="Button.word-button">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}" />
                <Setter Property="Background" Value="{DynamicResource SystemChromeHighColor}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="12,0" />
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </Style>

            <Style Selector="ToggleButton">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Cursor" Value="Hand" />
                <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
                </Style>
                <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
                </Style>
                <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundPointerOver}" />
                </Style>
                <Style Selector="^:checked  /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}" />
                </Style>
            </Style>

            <Style Selector="ContextMenu">
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
                <Setter Property="Padding" Value="6,1,6,1" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
            <Style Selector="MenuItem">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style
                Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
            </Style>

            <Style Selector="LucideIcon:disabled">
                <Setter Property="Opacity" Value="0.5" />
            </Style>

            <Style Selector="TextBox">
                <Setter Property="Background" Value="{DynamicResource SystemChromeHighColor}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseMediumLowColor}" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="FontFamily"
                        Value="{Binding SelectedMonoFontFamily, Source={x:Static vm:SettingsVM.Instance}}" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,0,10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding $parent[TextBox].Copy}"
                                Header="{echoes:Translate {x:Static translations:Strings+context_menu.copy}}"
                                IsEnabled="{Binding $parent[TextBox].CanCopy}">
                                <MenuItem.Icon>
                                    <LucideIcon Kind="Copy" Size="20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding ManualCut}"
                                CommandParameter="{Binding $parent[TextBox]}"
                                Header="{echoes:Translate {x:Static translations:Strings+context_menu.cut}}"
                                IsEnabled="{Binding $parent[TextBox].CanCut}">
                                <MenuItem.Icon>
                                    <LucideIcon Kind="Scissors" Size="20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding $parent[TextBox].Paste}"
                                Header="{echoes:Translate {x:Static translations:Strings+context_menu.paste}}"
                                IsEnabled="{Binding $parent[TextBox].CanPaste}">
                                <MenuItem.Icon>
                                    <LucideIcon Kind="ClipboardPaste" Size="20" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding $parent[TextBox].SelectAll}"
                                      Header="{echoes:Translate {x:Static translations:Strings+context_menu.select_all}}">
                                <MenuItem.Icon>
                                    <LucideIcon Kind="SquareDashed" Size="20" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
                <Style Selector="^:disabled">
                    <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumLowColor}" />
                </Style>
            </Style>

            <Style Selector="Slider">
                <Style.Resources>
                    <sys:Double x:Key="SliderHorizontalThumbWidth">16</sys:Double>
                    <sys:Double x:Key="SliderHorizontalThumbHeight">16</sys:Double>

                    <CornerRadius x:Key="SliderThumbCornerRadius">8</CornerRadius>

                    <sys:Double x:Key="SliderHorizontalHeight">22</sys:Double>

                    <GridLength x:Key="SliderPreContentMargin">8</GridLength>
                    <GridLength x:Key="SliderPostContentMargin">8</GridLength>
                </Style.Resources>
                <Setter Property="VerticalAlignment" Value="Center" />

                <Style Selector="^ /template/ Thumb">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border
                                Width="16"
                                Height="16"
                                Background="{DynamicResource SliderThumbBackground}"
                                BorderBrush="{DynamicResource SystemChromeMediumColor}"
                                BorderThickness="1"
                                CornerRadius="8" />
                        </ControlTemplate>
                    </Setter>
                </Style>
            </Style>

            <Style Selector="ComboBox">
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Height" Value="30" />
                <Style Selector="^:dropdownopen /template/ Border#Background">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Style>
            </Style>
            <Style Selector="DataValidationErrors">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style Selector="Arc.loading">
                <Style.Animations>
                    <Animation IterationCount="Infinite" Duration="0:0:1">
                        <KeyFrame Cue="0%">
                            <Setter Property="RotateTransform.Angle" Value="0" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="RotateTransform.Angle" Value="360" />
                        </KeyFrame>
                    </Animation>
                    <Animation
                        Easing="SineEaseInOut"
                        IterationCount="Infinite"
                        Duration="0:0:2">
                        <KeyFrame Cue="0%">
                            <Setter Property="SweepAngle" Value="30" />
                            <Setter Property="StartAngle" Value="0" />
                        </KeyFrame>
                        <KeyFrame Cue="50%">
                            <Setter Property="SweepAngle" Value="270" />
                            <Setter Property="StartAngle" Value="0" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="SweepAngle" Value="30" />
                            <Setter Property="StartAngle" Value="330" />
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>

            <Style Selector="ToolTip">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="ShowDelay" Value="100" />
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition
                            Easing="CircularEaseOut"
                            Property="Opacity"
                            Duration="0:0:0.2" />
                        <TransformOperationsTransition
                            Easing="BackEaseOut"
                            Property="RenderTransform"
                            Duration="0:0:0.25" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="ToolTip:open">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="RenderTransform" Value="scale(0.9)" />
            </Style>
            <Style Selector="ToolTip">
                <Setter Property="RenderTransform" Value="scale(0.8)" />
                <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            </Style>

            <Style Selector="ScrollViewer">
                <Setter Property="Interaction.Behaviors">
                    <BehaviorCollectionTemplate>
                        <BehaviorCollection>
                            <ia:VerticalScrollViewerAnimatedBehavior />
                        </BehaviorCollection>
                    </BehaviorCollectionTemplate>
                </Setter>
            </Style>

        </Grid.Styles>


        <!--  Main  -->
        <Grid IsVisible="{Binding !IsAppInitializing, Source={x:Static vm:SettingsVM.Instance}}" RowDefinitions="40,*">
            <Classes.blurred>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="IsSettingsOpen" />
                    <Binding Path="IsPromptEditorOpen" />
                    <Binding Path="IsDeletingMessageDialogOpen" />
                    <Binding Path="IsDeletingRecordDialogOpen" />
                </MultiBinding>
            </Classes.blurred>
            <Grid.Styles>
                <Style Selector="Grid.blurred">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="10" />
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Styles>
            <Border
                Background="{DynamicResource SystemChromeHighColor}"
                BorderThickness="0,0,0,1"
                DoubleTapped="Border_DoubleTapped"
                PointerPressed="Border_PointerPressed">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40">
                            <Image
                                Height="20"
                                Width="20"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Source="/Assets/icon32.ico"
                                Margin="0,0,0,3" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="WaifuAI" />
                    </StackPanel>

                    <Border x:Name="FakeTopBorder" MaxWidth="{StaticResource TopPanelEdgeWidth}" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        x:DataType="vm:SettingsVM"
                        DataContext="{x:Static vm:SettingsVM.Instance}"
                        Orientation="Horizontal"
                        Spacing="16">
                        <StackPanel.Styles>

                            <Style Selector="ProgressBar">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Width" Value="100" />
                                <Setter Property="CornerRadius" Value="3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Margin" Value="11,0,0,0" />
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <DoubleTransition
                                            Easing="QuadraticEaseOut"
                                            Property="Value"
                                            Duration="0:0:1.5" />
                                    </Transitions>
                                </Setter>
                            </Style>

                            <Style Selector="ProgressBar.mini-style">
                                <Setter Property="Height" Value="16" />
                                <Setter Property="Width" Value="3" />
                                <Setter Property="CornerRadius" Value="3" />
                                <Setter Property="Background" Value="{DynamicResource SystemBaseMediumColor}" />
                                <Setter Property="Orientation" Value="Vertical" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Margin" Value="25,0,0,0" />
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <DoubleTransition
                                            Easing="QuadraticEaseOut"
                                            Property="Value"
                                            Duration="0:0:1.5" />
                                    </Transitions>
                                </Setter>
                            </Style>

                        </StackPanel.Styles>

                        <!--  Affection  -->
                        <Grid
                            Background="Transparent"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="Bottom"
                            ToolTip.Tip="{Binding AffectionText}"
                            ToolTip.VerticalOffset="4">
                            <ProgressBar
                                MinWidth="0"
                                MinHeight="0"
                                BorderBrush="{Binding #AffectionIcon.Foreground}"
                                Classes.mini-style="{Binding #FakeTopBorder.Bounds.Width, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={StaticResource TopPanelEdgeWidth}}"
                                Foreground="{Binding #AffectionIcon.Foreground}"
                                Value="{Binding Affection}" />
                            <material:MaterialIcon
                                Margin="0,2,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemChromeHighColor}"
                                IconSize="22"
                                Kind="Favorite" />
                            <LucideIcon
                                x:Name="AffectionIcon"
                                Margin="2,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Classes.bad="{Binding AffectionLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AffectionType.Bad}}"
                                Classes.good="{Binding AffectionLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AffectionType.Good}}"
                                Classes.love="{Binding AffectionLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AffectionType.Love}}"
                                Classes.normal="{Binding AffectionLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AffectionType.Normal}}"
                                Size="18"
                                StrokeWidth="2.5">
                                <LucideIcon.Styles>
                                    <Style Selector="LucideIcon.bad">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
                                        <Setter Property="Kind" Value="HeartCrack" />
                                    </Style>
                                    <Style Selector="LucideIcon.normal">
                                        <Setter Property="Foreground" Value="#3a85ff" />
                                        <Setter Property="Kind" Value="Heart" />
                                    </Style>
                                    <Style Selector="LucideIcon.good">
                                        <Setter Property="Foreground" Value="#aa4eff" />
                                        <Setter Property="Kind" Value="Heart" />
                                    </Style>
                                    <Style Selector="LucideIcon.love">
                                        <Setter Property="Foreground" Value="#ff3737" />
                                        <Setter Property="Kind" Value="Heart" />
                                    </Style>
                                </LucideIcon.Styles>
                            </LucideIcon>

                        </Grid>

                        <!--  Engagement  -->
                        <Grid
                            Background="Transparent"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="Bottom"
                            ToolTip.Tip="{Binding EngagementText}"
                            ToolTip.VerticalOffset="4">
                            <ProgressBar
                                MinWidth="0"
                                MinHeight="0"
                                BorderBrush="{Binding #EngagementIcon.Foreground}"
                                Classes.mini-style="{Binding #FakeTopBorder.Bounds.Width, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={StaticResource TopPanelEdgeWidth}}"
                                Foreground="{Binding #EngagementIcon.Foreground}"
                                Value="{Binding Engagement}" />
                            <Border
                                Width="22"
                                Height="20"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemChromeHighColor}"
                                IsVisible="{Binding EngagementLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EngagementType.Indifferent}}" />
                            <Border
                                Width="20"
                                Height="20"
                                Margin="1,0,0,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemChromeHighColor}"
                                CornerRadius="0,10,11,0"
                                IsVisible="{Binding EngagementLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EngagementType.Balanced}}" />
                            <material:MaterialIcon
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource SystemChromeHighColor}"
                                IconSize="20"
                                IsVisible="{Binding EngagementLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EngagementType.Interested}}"
                                Kind="WaterDrop" />
                            <LucideIcon
                                x:Name="EngagementIcon"
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Classes.balanced="{Binding EngagementLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EngagementType.Balanced}}"
                                Classes.indifferent="{Binding EngagementLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EngagementType.Indifferent}}"
                                Classes.interested="{Binding EngagementLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EngagementType.Interested}}"
                                Size="18"
                                StrokeWidth="2.5">
                                <LucideIcon.Styles>
                                    <Style Selector="LucideIcon.indifferent">
                                        <Setter Property="Foreground" Value="#aaa1ff" />
                                        <Setter Property="Kind" Value="WavesHorizontal" />
                                    </Style>
                                    <Style Selector="LucideIcon.balanced">
                                        <Setter Property="Foreground" Value="#2f9e44" />
                                        <Setter Property="Kind" Value="Leaf" />
                                    </Style>
                                    <Style Selector="LucideIcon.interested">
                                        <Setter Property="Foreground" Value="#ff9e37" />
                                        <Setter Property="Kind" Value="Flame" />
                                    </Style>
                                </LucideIcon.Styles>
                            </LucideIcon>
                        </Grid>

                        <!--  Mood  -->
                        <Grid
                            Background="Transparent"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="Bottom"
                            ToolTip.Tip="{Binding MoodText}"
                            ToolTip.VerticalOffset="4">
                            <ProgressBar
                                MinWidth="0"
                                MinHeight="0"
                                BorderBrush="{Binding #MoodIcon.Foreground}"
                                Classes.mini-style="{Binding #FakeTopBorder.Bounds.Width, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={StaticResource TopPanelEdgeWidth}}"
                                Foreground="{Binding #MoodIcon.Foreground}"
                                Value="{Binding Mood}" />
                            <Border
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemChromeHighColor}"
                                CornerRadius="11" />
                            <LucideIcon
                                x:Name="MoodIcon"
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Classes.bad="{Binding MoodLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:MoodType.Bad}}"
                                Classes.best="{Binding MoodLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:MoodType.Best}}"
                                Classes.normal="{Binding MoodLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:MoodType.Normal}}"
                                Size="18"
                                StrokeWidth="2.5">
                                <LucideIcon.Styles>
                                    <Style Selector="LucideIcon.bad">
                                        <Setter Property="Foreground" Value="#ff3a3a" />
                                        <Setter Property="Kind" Value="Frown" />
                                    </Style>
                                    <Style Selector="LucideIcon.normal">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
                                        <Setter Property="Kind" Value="Meh" />
                                    </Style>
                                    <Style Selector="LucideIcon.best">
                                        <Setter Property="Foreground" Value="#24b55c" />
                                        <Setter Property="Kind" Value="Smile" />
                                    </Style>
                                </LucideIcon.Styles>
                            </LucideIcon>
                        </Grid>

                        <!--  Energy  -->
                        <Grid
                            Background="Transparent"
                            ToolTip.HorizontalOffset="0"
                            ToolTip.Placement="Bottom"
                            ToolTip.Tip="{Binding EnergyText}"
                            ToolTip.VerticalOffset="4">
                            <ProgressBar
                                MinWidth="0"
                                MinHeight="0"
                                BorderBrush="{Binding #EnergyIcon.Foreground}"
                                Classes.mini-style="{Binding #FakeTopBorder.Bounds.Width, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={StaticResource TopPanelEdgeWidth}}"
                                Foreground="{Binding #EnergyIcon.Foreground}"
                                Value="{Binding Energy}" />
                            <Border
                                Width="12"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SystemChromeHighColor}"
                                Classes.not-low="{Binding EnergyLevel, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static models:EnergyType.Low}}"
                                RenderTransformOrigin="50%,50%">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                                <Border.Styles>
                                    <Style Selector="Border">
                                        <Setter Property="CornerRadius" Value="0,0,0,0" />
                                        <Setter Property="Margin" Value="5,2,0,0" />
                                    </Style>
                                    <Style Selector="Border.not-low">
                                        <Setter Property="CornerRadius" Value="0,8,0,0" />
                                        <Setter Property="Margin" Value="7,2,0,0" />
                                    </Style>
                                </Border.Styles>
                            </Border>
                            <LucideIcon
                                x:Name="EnergyIcon"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Classes.high="{Binding EnergyLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EnergyType.High}}"
                                Classes.low="{Binding EnergyLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EnergyType.Low}}"
                                Classes.middle="{Binding EnergyLevel, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:EnergyType.Middle}}"
                                Size="18"
                                StrokeWidth="2.5">
                                <LucideIcon.Styles>
                                    <Style Selector="LucideIcon.low">
                                        <Setter Property="Foreground" Value="#ff3a3a" />
                                        <Setter Property="Kind" Value="PlugZap" />
                                        <Setter Property="Margin" Value="4,0,0,0" />
                                    </Style>
                                    <Style Selector="LucideIcon.middle">
                                        <Setter Property="Foreground" Value="#ffa11d" />
                                        <Setter Property="Kind" Value="Zap" />
                                        <Setter Property="Margin" Value="2,0,0,0" />
                                    </Style>
                                    <Style Selector="LucideIcon.high">
                                        <Setter Property="Foreground" Value="#fff04b" />
                                        <Setter Property="Kind" Value="Zap" />
                                        <Setter Property="Margin" Value="2,0,0,0" />
                                    </Style>
                                </LucideIcon.Styles>
                            </LucideIcon>
                        </Grid>

                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="2"
                        Tag="{Binding IsWindows}">
                        <CaptionButtons
                            MaxHeight="100"
                            IsVisible="{Binding IsWindows}"
                            Tag="{Binding IsMaximized}">
                            <CaptionButtons.Styles>
                                <Style Selector="CaptionButtons[Tag=False] Button#PART_RestoreButton Path">
                                    <Setter Property="Data"
                                            Value="M2048 2048v-2048h-2048v2048h2048zM1843 1843h-1638v-1638h1638v1638z" />
                                </Style>
                                <Style Selector="CaptionButtons[Tag=True] Button#PART_RestoreButton Path">
                                    <Setter Property="Data"
                                            Value="M2048 410h-410v-410h-1638v1638h410v410h1638v-1638zM1434 1434h-1229v-1229h1229v1229zM1843 1843h-1229v-205h1024v-1024h205v1229z" />
                                </Style>
                                <Style Selector="Button">
                                    <Setter Property="Width" Value="44" />
                                    <Setter Property="Height" Value="39" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style Selector="Button#PART_MinimizeButton:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                                </Style>
                                <Style Selector="Button#PART_RestoreButton:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </Style>
                                <Style
                                    Selector="Button#PART_CloseButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Opacity="0.7" Color="Red" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Opacity" Value="0.7" />
                                </Style>
                                <Style Selector="Button#PART_CloseButton:pointerover Path">
                                    <Setter Property="Stroke" Value="White" />
                                    <Setter Property="Fill" Value="White" />
                                </Style>
                            </CaptionButtons.Styles>
                        </CaptionButtons>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="MainGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="400" MinWidth="400" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SystemChromeMediumColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Spacing="4">
                            <ToggleButton
                                x:Name="ChatButton"
                                IsChecked="True"
                                IsCheckedChanged="LeftToggleButton_OnIsCheckedChanged"
                                ToolTip.HorizontalOffset="4"
                                ToolTip.Placement="Right"
                                ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+sidepanel.chat}}"
                                ToolTip.VerticalOffset="0">
                                <LucideIcon Kind="MessageSquareText" Size="20" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="MemoryButton"
                                IsCheckedChanged="LeftToggleButton_OnIsCheckedChanged"
                                ToolTip.HorizontalOffset="4"
                                ToolTip.Placement="Right"
                                ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+sidepanel.knowledge_base}}"
                                ToolTip.VerticalOffset="0">
                                <LucideIcon Kind="BookText" Size="20" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="PersonalityButton"
                                IsCheckedChanged="LeftToggleButton_OnIsCheckedChanged"
                                ToolTip.HorizontalOffset="4"
                                ToolTip.Placement="Right"
                                ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+sidepanel.personality}}"
                                ToolTip.VerticalOffset="0">
                                <LucideIcon Kind="Brain" Size="20" />
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Spacing="4">

                            <ToggleButton
                                x:Name="ParametersButton"
                                IsCheckedChanged="LeftToggleButton_OnIsCheckedChanged"
                                ToolTip.HorizontalOffset="4"
                                ToolTip.Placement="Right"
                                ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+sidepanel.ai_parameters}}"
                                ToolTip.VerticalOffset="0">
                                <LucideIcon Kind="Settings2" Size="20" />
                            </ToggleButton>
                            <ToggleButton
                                x:Name="ModelButton"
                                IsCheckedChanged="LeftToggleButton_OnIsCheckedChanged"
                                ToolTip.HorizontalOffset="4"
                                ToolTip.Placement="Right"
                                ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+sidepanel.model_source}}"
                                ToolTip.VerticalOffset="0">
                                <LucideIcon Kind="Server" Size="20" />
                            </ToggleButton>
                            <Button
                                Classes="icon-button"
                                Command="{Binding SettingsCommand}"
                                ToolTip.HorizontalOffset="4"
                                ToolTip.Placement="Right"
                                ToolTip.Tip="{echoes:Translate {x:Static translations:Strings.settings}}"
                                ToolTip.VerticalOffset="0">
                                <LucideIcon Kind="Settings" Size="20" />
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>


                <!--  LeftPanel  -->
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderThickness="0,0,1,0">
                    <Panel>

                        <!--  Chat  -->
                        <views:SidePanel Header="{echoes:Translate {x:Static translations:Strings+sidepanel.chat}}"
                                         IsVisible="{Binding #ChatButton.IsChecked}">
                            <Grid RowDefinitions="*,Auto">
                                <ScrollViewer x:Name="ChatScrollViewer">
                                    <ScrollViewer.Styles>
                                        <Style Selector="ScrollViewer">
                                            <Setter Property="Interaction.Behaviors">
                                                <BehaviorCollectionTemplate>
                                                    <BehaviorCollection />
                                                </BehaviorCollectionTemplate>
                                            </Setter>
                                        </Style>
                                    </ScrollViewer.Styles>

                                    <ItemsRepeater
                                        x:Name="MessageList"
                                        Background="{DynamicResource SystemChromeMediumColor}"
                                        ItemsSource="{Binding Chat}"
                                        Tag="{Binding IsMultiSelect}"
                                        ElementPrepared="OnElementPrepared"
                                        ElementClearing="OnElementClearing">

                                        <ItemsRepeater.Layout>
                                            <StackLayout />
                                        </ItemsRepeater.Layout>

                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Background="Transparent"
                                                    IsHitTestVisible="{Binding MessageModel.Role, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=temp}">

                                                    <Interaction.Behaviors>
                                                        <RoutedEventTriggerBehavior
                                                            RoutedEvent="{x:Static InputElement.PointerPressedEvent}"
                                                            RoutingStrategies="Tunnel">
                                                            <InvokeCommandAction
                                                                Command="{Binding #MessageList.((vm:MainVM)DataContext).AddOrRemoveSelectedCommand}"
                                                                CommandParameter="{Binding}" />
                                                            <custom:InvokeCommandOnLeftClickAction
                                                                Command="{Binding #MessageList.((vm:MainVM)DataContext).MultiSelectAddOrRemoveSelectedCommand}"
                                                                CommandParameter="{Binding}" />
                                                        </RoutedEventTriggerBehavior>

                                                    </Interaction.Behaviors>

                                                    <Border Background="{DynamicResource SystemAccentColor}"
                                                            IsHitTestVisible="False"
                                                            Classes.highlighted="{Binding IsHighlighted}">

                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="Opacity" Value="0" />
                                                                <Setter Property="Transitions">
                                                                    <Setter.Value>
                                                                        <Transitions>
                                                                            <DoubleTransition Property="Opacity"
                                                                                    Duration="0:0:0.5"
                                                                                    Easing="CircularEaseOut" />
                                                                        </Transitions>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                            <Style Selector="Border.highlighted">
                                                                <Setter Property="Opacity" Value="0.4" />
                                                            </Style>
                                                        </Border.Styles>
                                                    </Border>

                                                    <Border>
                                                        <Border.Tag>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="IsSelected" />
                                                                <Binding Path="$parent[ItemsRepeater].Tag" />
                                                            </MultiBinding>
                                                        </Border.Tag>
                                                        <Border.Styles>
                                                            <Style Selector="Border[Tag=True]">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SystemAccentColor}" />
                                                                <Setter Property="Opacity" Value="0.4" />
                                                            </Style>
                                                            <Style Selector="Border[Tag=False]">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </Style>
                                                        </Border.Styles>
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem
                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.select}}"
                                                                    IsVisible="{Binding !$parent[ItemsRepeater].Tag}">
                                                                    <MenuItem.Icon>
                                                                        <LucideIcon Kind="CircleCheck" Size="20" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem
                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.cancel_select}}"
                                                                    IsVisible="{Binding $parent[ItemsRepeater].Tag}">
                                                                    <MenuItem.Icon>
                                                                        <LucideIcon Kind="CircleX" Size="20" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                    </Border>
                                                    <Grid MaxWidth="720" ColumnDefinitions="Auto,*,Auto">
                                                        <Border
                                                            MinHeight="32"
                                                            MaxWidth="360"
                                                            Margin="16,6,16,6"
                                                            Padding="12,6,12,6"
                                                            Background="{DynamicResource SystemListLowColor}"
                                                            BorderBrush="{DynamicResource SystemListMediumColor}"
                                                            BorderThickness="1"
                                                            Tag="{Binding MessageModel.Role}">
                                                            <Border.Styles>
                                                                <Style Selector="Border">
                                                                    <Setter Property="Grid.Column" Value="2" />
                                                                    <Setter Property="CornerRadius" Value="16,16,4,16" />
                                                                    <Setter Property="ContextMenu">
                                                                        <Setter.Value>
                                                                            <ContextMenu>
                                                                                <MenuItem
                                                                                    x:DataType="vm:MainVM"
                                                                                    Command="{Binding CopyMessageTextCommand}"
                                                                                    CommandParameter="{Binding #PART_SelectableTextBlock}"
                                                                                    DataContext="{Binding $parent[ItemsRepeater].DataContext}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.copy_text}}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="Copy"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).MakeReplyCommand}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.reply}}"
                                                                                    IsVisible="{Binding !IsFailed}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon
                                                                                            Kind="MessageSquareReply"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.select}}"
                                                                                    IsVisible="{Binding !$parent[ItemsRepeater].((vm:MainVM)DataContext).IsMultiSelect}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="CircleCheck"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.cancel_select}}"
                                                                                    IsVisible="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).IsMultiSelect}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="CircleX"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    x:DataType="vm:MainVM"
                                                                                    Command="{Binding DeletingMessageDialogCommand}"
                                                                                    DataContext="{Binding $parent[ItemsRepeater].DataContext}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.delete}}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="Trash2"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                    <MenuItem.Styles>
                                                                                        <Style Selector="MenuItem">
                                                                                            <Setter
                                                                                                Property="Foreground"
                                                                                                Value="Red" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                                                                                            <Setter
                                                                                                Property="Foreground"
                                                                                                Value="Red" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
                                                                                            <Setter
                                                                                                Property="Background">
                                                                                                <SolidColorBrush
                                                                                                    Opacity="0.15"
                                                                                                    Color="Red" />
                                                                                            </Setter>
                                                                                        </Style>
                                                                                    </MenuItem.Styles>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                                <Style Selector="Border[Tag=assistant]">
                                                                    <Setter Property="Grid.Column" Value="0" />
                                                                    <Setter Property="CornerRadius" Value="16,16,16,4" />
                                                                    <Setter Property="ContextMenu">
                                                                        <Setter.Value>
                                                                            <ContextMenu>
                                                                                <MenuItem
                                                                                    x:DataType="vm:MainVM"
                                                                                    Command="{Binding CopyMessageTextCommand}"
                                                                                    CommandParameter="{Binding #PART_SelectableTextBlock}"
                                                                                    DataContext="{Binding $parent[ItemsRepeater].DataContext}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.copy_text}}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="Copy"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).MakeReplyCommand}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.reply}}"
                                                                                    IsVisible="{Binding !IsFailed}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon
                                                                                            Kind="MessageSquareReply"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.select}}"
                                                                                    IsVisible="{Binding !$parent[ItemsRepeater].((vm:MainVM)DataContext).IsMultiSelect}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="CircleCheck"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.cancel_select}}"
                                                                                    IsVisible="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).IsMultiSelect}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="CircleX"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    x:DataType="vm:MainVM"
                                                                                    Command="{Binding DeletingMessageDialogCommand}"
                                                                                    DataContext="{Binding $parent[ItemsRepeater].DataContext}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.delete}}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="Trash2"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                    <MenuItem.Styles>
                                                                                        <Style Selector="MenuItem">
                                                                                            <Setter
                                                                                                Property="Foreground"
                                                                                                Value="Red" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                                                                                            <Setter
                                                                                                Property="Foreground"
                                                                                                Value="Red" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
                                                                                            <Setter
                                                                                                Property="Background">
                                                                                                <SolidColorBrush
                                                                                                    Opacity="0.15"
                                                                                                    Color="Red" />
                                                                                            </Setter>
                                                                                        </Style>
                                                                                    </MenuItem.Styles>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                                <Style Selector="Border[Tag=temp]">
                                                                    <Setter Property="Grid.Column" Value="0" />
                                                                    <Setter Property="CornerRadius" Value="16,16,16,4" />
                                                                    <Setter Property="Width" Value="64" />
                                                                    <Setter Property="ContextMenu" Value="{x:Null}" />
                                                                </Style>
                                                            </Border.Styles>
                                                            <Grid>
                                                                <StackPanel Spacing="2">
                                                                    <Button
                                                                        Width="Nan"
                                                                        Height="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ReplyButtonHeight}"
                                                                        Padding="0"
                                                                        HorizontalAlignment="Stretch"
                                                                        BorderThickness="0"
                                                                        CornerRadius="6"
                                                                        IsVisible="{Binding ReplyMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                        <Interaction.Behaviors>
                                                                            <BehaviorCollection>
                                                                                <EventTriggerBehavior EventName="Click">
                                                                                    <InvokeCommandAction
                                                                                        Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ScrollToMessageCommand}"
                                                                                        CommandParameter="{Binding}" />
                                                                                </EventTriggerBehavior>
                                                                            </BehaviorCollection>
                                                                        </Interaction.Behaviors>
                                                                        <Grid ColumnDefinitions="4,*">
                                                                            <Border
                                                                                Grid.Column="0"
                                                                                Width="4"
                                                                                CornerRadius="6,0,0,6"
                                                                                Tag="{Binding ReplyMessage.MessageModel.Role}">
                                                                                <Border.Styles>
                                                                                    <Style Selector="Border[Tag=user]">
                                                                                        <Setter Property="Background"
                                                                                            Value="{DynamicResource SystemAccentColor}" />
                                                                                    </Style>
                                                                                    <Style
                                                                                        Selector="Border[Tag=assistant]">
                                                                                        <Setter Property="Background">
                                                                                            <Setter.Value>
                                                                                                <SolidColorBrush
                                                                                                    Color="{Binding SelectedArchetype.Color, Source={x:Static vm:SettingsVM.Instance}}" />
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Style>
                                                                                </Border.Styles>
                                                                            </Border>
                                                                            <StackPanel
                                                                                Grid.Column="1"
                                                                                Margin="8,0,8,0"
                                                                                Spacing="1"
                                                                                VerticalAlignment="Center">
                                                                                <TextBlock
                                                                                    HorizontalAlignment="Left"
                                                                                    FontWeight="Bold"
                                                                                    Tag="{Binding ReplyMessage.MessageModel.Role}"
                                                                                    TextTrimming="CharacterEllipsis">
                                                                                    <TextBlock.Styles>
                                                                                        <Style
                                                                                            Selector="Border[Tag=user]">
                                                                                            <Setter
                                                                                                Property="Background"
                                                                                                Value="{DynamicResource SystemAccentColor}" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="Border[Tag=assistant]">
                                                                                            <Setter
                                                                                                Property="Background">
                                                                                                <Setter.Value>
                                                                                                    <SolidColorBrush
                                                                                                        Color="{Binding SelectedArchetype.Color, Source={x:Static vm:SettingsVM.Instance}}" />
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="TextBlock[Tag=assistant]">
                                                                                            <Setter Property="Text"
                                                                                                Value="{Binding Source={x:Static vm:SettingsVM.Instance}, Path=WaifuName}" />
                                                                                            <Setter
                                                                                                Property="Foreground">
                                                                                                <Setter.Value>
                                                                                                    <SolidColorBrush
                                                                                                        Color="{Binding SelectedArchetype.Color, Source={x:Static vm:SettingsVM.Instance}}" />
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="TextBlock[Tag=user]">
                                                                                            <Setter
                                                                                                Property="Foreground"
                                                                                                Value="{DynamicResource SystemAccentColor}" />
                                                                                            <Setter Property="Text"
                                                                                                Value="{Binding Source={x:Static vm:SettingsVM.Instance}, Path=UserName, TargetNullValue='User'}" />
                                                                                        </Style>
                                                                                    </TextBlock.Styles>
                                                                                </TextBlock>
                                                                                <TextBlock
                                                                                    HorizontalAlignment="Left"
                                                                                    Text="{Binding Quote}"
                                                                                    MaxLines="1"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Button>
                                                                    <SelectableTextBlock
                                                                        x:Name="PART_SelectableTextBlock"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent"
                                                                        Initialized="PART_SelectableTextBlock_Initialized"
                                                                        IsHitTestVisible="{Binding !$parent[ItemsRepeater].Tag}"
                                                                        SelectionEnd="{Binding SelectionEnd, Mode=TwoWay}"
                                                                        SelectionStart="{Binding SelectionStart, Mode=TwoWay}"
                                                                        Tag="{Binding IsHighlighted}"
                                                                        Text="{Binding MessageModel.CleanText}"
                                                                        TextWrapping="Wrap">
                                                                        <SelectableTextBlock.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem
                                                                                    x:DataType="vm:MainVM"
                                                                                    DataContext="{Binding $parent[ItemsRepeater].DataContext}"
                                                                                    Tag="{Binding #PART_SelectableTextBlock.CanCopy}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="Copy"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                    <MenuItem.Styles>
                                                                                        <Style
                                                                                            Selector="MenuItem[Tag=True]">
                                                                                            <Setter Property="Header"
                                                                                                Value="{echoes:Translate {x:Static translations:Strings+context_menu.copy_selected}}" />
                                                                                            <Setter Property="Command"
                                                                                                Value="{Binding #PART_SelectableTextBlock.Copy}" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem[Tag=False]">
                                                                                            <Setter Property="Header"
                                                                                                Value="{echoes:Translate {x:Static translations:Strings+context_menu.copy_text}}" />
                                                                                            <Setter Property="Command"
                                                                                                Value="{Binding CopyMessageTextCommand}" />
                                                                                            <Setter
                                                                                                Property="CommandParameter"
                                                                                                Value="{Binding #PART_SelectableTextBlock}" />
                                                                                        </Style>
                                                                                    </MenuItem.Styles>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    IsVisible="{Binding !IsFailed}"
                                                                                    Tag="{Binding #PART_SelectableTextBlock.CanCopy}">
                                                                                    <MenuItem.Styles>
                                                                                        <Style
                                                                                            Selector="MenuItem[Tag=True]">
                                                                                            <Setter Property="Header"
                                                                                                Value="{echoes:Translate {x:Static translations:Strings+context_menu.reply_quote}}" />
                                                                                            <Setter Property="Icon">
                                                                                                <Setter.Value>
                                                                                                    <Template>
                                                                                                        <LucideIcon
                                                                                                            Kind="MessageSquareQuote"
                                                                                                            Size="20" />
                                                                                                    </Template>
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                            <Setter Property="Command"
                                                                                                Value="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).MakeQuoteCommand}" />
                                                                                            <Setter
                                                                                                Property="CommandParameter"
                                                                                                Value="{Binding #PART_SelectableTextBlock.SelectedText}" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem[Tag=False]">
                                                                                            <Setter Property="Header"
                                                                                                Value="{echoes:Translate {x:Static translations:Strings+context_menu.reply}}" />
                                                                                            <Setter Property="Icon">
                                                                                                <Setter.Value>
                                                                                                    <Template>
                                                                                                        <LucideIcon
                                                                                                            Kind="MessageSquareReply"
                                                                                                            Size="20" />
                                                                                                    </Template>
                                                                                                </Setter.Value>
                                                                                            </Setter>
                                                                                            <Setter Property="Command"
                                                                                                Value="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).MakeReplyCommand}" />
                                                                                        </Style>
                                                                                    </MenuItem.Styles>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.select}}"
                                                                                    IsVisible="{Binding !$parent[ItemsRepeater].((vm:MainVM)DataContext).IsMultiSelect}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="CircleCheck"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    Command="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).ToggleMultiSelectCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.cancel_select}}"
                                                                                    IsVisible="{Binding $parent[ItemsRepeater].((vm:MainVM)DataContext).IsMultiSelect}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="CircleX"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                </MenuItem>
                                                                                <MenuItem
                                                                                    x:DataType="vm:MainVM"
                                                                                    Command="{Binding DeletingMessageDialogCommand}"
                                                                                    DataContext="{Binding $parent[ItemsRepeater].DataContext}"
                                                                                    Header="{echoes:Translate {x:Static translations:Strings+context_menu.delete}}">
                                                                                    <MenuItem.Icon>
                                                                                        <LucideIcon Kind="Trash2"
                                                                                            Size="20" />
                                                                                    </MenuItem.Icon>
                                                                                    <MenuItem.Styles>
                                                                                        <Style Selector="MenuItem">
                                                                                            <Setter
                                                                                                Property="Foreground"
                                                                                                Value="Red" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                                                                                            <Setter
                                                                                                Property="Foreground"
                                                                                                Value="Red" />
                                                                                        </Style>
                                                                                        <Style
                                                                                            Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
                                                                                            <Setter
                                                                                                Property="Background">
                                                                                                <SolidColorBrush
                                                                                                    Opacity="0.15"
                                                                                                    Color="Red" />
                                                                                            </Setter>
                                                                                        </Style>
                                                                                    </MenuItem.Styles>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </SelectableTextBlock.ContextMenu>
                                                                    </SelectableTextBlock>
                                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                                                          IsVisible="{Binding MessageModel.Role, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=temp}">
                                                                        <LucideIcon
                                                                            Margin="0,0,3,0"
                                                                            Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                            Kind="WeightTilde"
                                                                            Size="14" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            FontSize="12"
                                                                            Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                            Text="{Binding TokensText}" />
                                                                        <Separator
                                                                            Grid.Column="2"
                                                                            Width="1"
                                                                            Height="NaN"
                                                                            Margin="8,2,8,2"
                                                                            Background="{DynamicResource SystemBaseLowColor}"
                                                                            Tag="{Binding #PART_Column2.Bounds.Width}">
                                                                            <Separator.Styles>
                                                                                <Style Selector="Separator">
                                                                                    <Setter Property="IsVisible"
                                                                                        Value="False" />
                                                                                </Style>
                                                                                <Style Selector="Separator[Tag=0]">
                                                                                    <Setter Property="IsVisible"
                                                                                        Value="True" />
                                                                                </Style>
                                                                            </Separator.Styles>
                                                                        </Separator>
                                                                        <Border x:Name="PART_Column2" Grid.Column="3" />
                                                                        <TextBlock
                                                                            Grid.Column="4"
                                                                            FontSize="12"
                                                                            Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                            Text="{Binding LocalTime, StringFormat='{}{0:HH:mm}'}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                                <!--  Loading animation  -->
                                                                <StackPanel
                                                                    Grid.Column="0"
                                                                    HorizontalAlignment="Center"
                                                                    IsVisible="{Binding MessageModel.Role, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=temp}"
                                                                    Orientation="Horizontal"
                                                                    Spacing="5">
                                                                    <StackPanel.Styles>
                                                                        <Style Selector="Ellipse.dot">
                                                                            <Setter Property="Width" Value="8" />
                                                                            <Setter Property="Height" Value="8" />
                                                                            <Setter Property="Fill"
                                                                                    Value="{DynamicResource SystemBaseHighColor}" />
                                                                            <Setter Property="RenderTransformOrigin"
                                                                                    Value="50%,50%" />
                                                                        </Style>
                                                                        <Style Selector="Ellipse.dot1">
                                                                            <Style.Animations>
                                                                                <Animation
                                                                                    Delay="0:0:0.0"
                                                                                    IterationCount="Infinite"
                                                                                    Duration="0:0:1.2">
                                                                                    <KeyFrame Cue="0%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="0.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="0.8" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="0.8" />
                                                                                    </KeyFrame>
                                                                                    <KeyFrame Cue="50%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="1" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="1.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="1.2" />
                                                                                    </KeyFrame>
                                                                                    <KeyFrame Cue="100%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="0.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="0.8" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="0.8" />
                                                                                    </KeyFrame>
                                                                                </Animation>
                                                                            </Style.Animations>
                                                                        </Style>
                                                                        <Style Selector="Ellipse.dot2">
                                                                            <Style.Animations>
                                                                                <Animation
                                                                                    Delay="0:0:0.4"
                                                                                    IterationCount="Infinite"
                                                                                    Duration="0:0:1.2">
                                                                                    <KeyFrame Cue="0%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="0.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="0.8" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="0.8" />
                                                                                    </KeyFrame>
                                                                                    <KeyFrame Cue="50%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="1" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="1.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="1.2" />
                                                                                    </KeyFrame>
                                                                                    <KeyFrame Cue="100%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="0.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="0.8" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="0.8" />
                                                                                    </KeyFrame>
                                                                                </Animation>
                                                                            </Style.Animations>
                                                                        </Style>
                                                                        <Style Selector="Ellipse.dot3">
                                                                            <Style.Animations>
                                                                                <Animation
                                                                                    Delay="0:0:0.8"
                                                                                    IterationCount="Infinite"
                                                                                    Duration="0:0:1.2">
                                                                                    <KeyFrame Cue="0%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="0.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="0.8" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="0.8" />
                                                                                    </KeyFrame>
                                                                                    <KeyFrame Cue="50%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="1" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="1.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="1.2" />
                                                                                    </KeyFrame>
                                                                                    <KeyFrame Cue="100%">
                                                                                        <Setter Property="Opacity"
                                                                                            Value="0.2" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleX"
                                                                                            Value="0.8" />
                                                                                        <Setter
                                                                                            Property="ScaleTransform.ScaleY"
                                                                                            Value="0.8" />
                                                                                    </KeyFrame>
                                                                                </Animation>
                                                                            </Style.Animations>
                                                                        </Style>
                                                                    </StackPanel.Styles>
                                                                    <Ellipse Classes="dot dot1" />
                                                                    <Ellipse Classes="dot dot2" />
                                                                    <Ellipse Classes="dot dot3" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <LucideIcon
                                                            Grid.Column="1"
                                                            Margin="0,12,0,12"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            IsVisible="{Binding IsFailed}"
                                                            Kind="CircleAlert"
                                                            Size="20" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <!--  Error Popup  -->
                                <Border
                                    MinHeight="60"
                                    MaxWidth="720"
                                    Margin="10"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource ErrorLowColor}"
                                    BorderBrush="{DynamicResource SystemErrorTextColor}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <SelectableTextBlock
                                            x:Name="ErrorTextBlock"
                                            Margin="10,6,10,6"
                                            Background="Transparent"
                                            Foreground="{DynamicResource SystemErrorTextColor}"
                                            Text="{Binding Error}"
                                            TextWrapping="Wrap">
                                            <SelectableTextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="{Binding #ErrorTextBlock.Copy}"
                                                              Header="{echoes:Translate {x:Static translations:Strings+context_menu.copy}}">
                                                        <MenuItem.Icon>
                                                            <LucideIcon Kind="Copy" Size="20" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </SelectableTextBlock.ContextMenu>
                                        </SelectableTextBlock>
                                        <Button
                                            Grid.Column="1"
                                            Width="24"
                                            Height="24"
                                            Margin="4"
                                            VerticalAlignment="Top"
                                            Classes="icon-button"
                                            Command="{Binding CloseErrorMessageCommand}"
                                            Foreground="{DynamicResource SystemErrorTextColor}">
                                            <Button.Styles>
                                                <Style
                                                    Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemErrorTextColor}" />
                                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                                </Style>
                                                <Style
                                                    Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemErrorTextColor}" />
                                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                                </Style>
                                            </Button.Styles>
                                            <LucideIcon Kind="X" Size="18" />
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Width="24"
                                            Height="24"
                                            Margin="4"
                                            VerticalAlignment="Bottom"
                                            Classes="icon-button"
                                            Click="CopyErrorButton_Click"
                                            Command="{Binding CopyMessageTextCommand}"
                                            CommandParameter="{Binding #ErrorTextBlock}"
                                            Foreground="{DynamicResource SystemErrorTextColor}">
                                            <Button.Styles>
                                                <Style
                                                    Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemErrorTextColor}" />
                                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                                </Style>
                                                <Style
                                                    Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemErrorTextColor}" />
                                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                                </Style>
                                            </Button.Styles>
                                            <LucideIcon Kind="Copy" Size="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <!--  Text Input  -->
                                <Border
                                    Grid.Row="1"
                                    MaxWidth="720"
                                    Background="{DynamicResource SystemChromeHighColor}"
                                    Tag="{Binding $self.Bounds.Width}">
                                    <Border.Styles>
                                        <Style Selector="Border">
                                            <Setter Property="BorderThickness" Value="0,1,0,0" />
                                        </Style>
                                        <Style Selector="Border[Tag=720]">
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="CornerRadius" Value="7" />
                                            <Setter Property="BorderThickness" Value="1,1,1,1" />
                                        </Style>
                                    </Border.Styles>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <Grid
                                            Grid.ColumnSpan="2"
                                            ColumnDefinitions="Auto,*,Auto"
                                            RowDefinitions="*,*">
                                            <LucideIcon
                                                Grid.RowSpan="2"
                                                Margin="10,0,10,0"
                                                IsVisible="{Binding ReplyMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Size="24"
                                                Tag="{Binding ReplyMessage.IsReplied}">
                                                <LucideIcon.Styles>
                                                    <Style Selector="LucideIcon[Tag=true]">
                                                        <Setter Property="Kind" Value="MessageSquareReply" />
                                                    </Style>
                                                    <Style Selector="LucideIcon[Tag=false]">
                                                        <Setter Property="Kind" Value="MessageSquareQuote" />
                                                    </Style>
                                                </LucideIcon.Styles>
                                            </LucideIcon>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,4,0,0"
                                                FontWeight="Bold"
                                                IsVisible="{Binding ReplyMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Tag="{Binding ReplyMessage.IsReplied}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock[Tag=true]">
                                                        <Setter Property="Text"
                                                                Value="{echoes:Translate {x:Static translations:Strings+sidepanel+chat_panel.reply}}" />
                                                    </Style>
                                                    <Style Selector="TextBlock[Tag=false]">
                                                        <Setter Property="Text"
                                                                Value="{echoes:Translate {x:Static translations:Strings+sidepanel+chat_panel.reply_quote}}" />
                                                    </Style>
                                                </TextBlock.Styles>
                                            </TextBlock>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                IsVisible="{Binding ReplyMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Text="{Binding Quote}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="2"
                                                Width="30"
                                                Height="30"
                                                Margin="6,0,6,0"
                                                VerticalAlignment="Center"
                                                Classes="icon-button"
                                                Command="{Binding ReleaseReplyAndQuoteCommand}"
                                                IsVisible="{Binding ReplyMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <LucideIcon Kind="X" />
                                            </Button>
                                        </Grid>
                                        <TextBox
                                            x:Name="TextBox"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Height="NaN"
                                            MinHeight="40"
                                            MaxHeight="300"
                                            Padding="12,6,12,6"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            FontFamily="{Binding SelectedFontFamily, Source={x:Static vm:SettingsVM.Instance}}"
                                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                            Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap"
                                            Watermark="{echoes:Translate {x:Static translations:Strings+sidepanel+chat_panel.write_a_message}}">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                                                                 Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled"
                                                                 Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                                                 Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
                                            </TextBox.Resources>
                                            <TextBox.Styles>
                                                <Style Selector="Border">
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </TextBox.Styles>
                                            <TextBox.KeyBindings>
                                                <KeyBinding
                                                    Command="{Binding InsertNewLineCommand}"
                                                    CommandParameter="{Binding #TextBox}"
                                                    Gesture="Shift+Enter" />
                                                <KeyBinding Command="{Binding RequestCommand}" Gesture="Enter" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            IsVisible="{Binding Source={x:Static vm:SettingsVM.Instance}, Path=!IsSleeping, Mode=TwoWay}"
                                            Orientation="Horizontal">
                                            <Button
                                                Margin="3"
                                                Classes="icon-button"
                                                Command="{Binding RequestCommand}">
                                                <LucideIcon Kind="SendHorizontal" Size="20" />
                                            </Button>
                                            <Button Margin="3" Classes="icon-button" IsVisible="False">
                                                <LucideIcon Kind="Mic" Size="20" />
                                            </Button>
                                        </StackPanel>
                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Height="24"
                                            Margin="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource ErrorColor}"
                                            CornerRadius="12"
                                            IsVisible="{Binding Source={x:Static vm:SettingsVM.Instance}, Path=IsSleeping, Mode=TwoWay}">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock
                                                    Margin="8,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                                    Opacity="0"
                                                    Text="{Binding RemainingSleepTimeMask}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource SystemErrorTextColor}"
                                                    Text="{Binding RemainingSleepTimeText}" />
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="10,0,0,6"
                                            Padding="7,3,6,3"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource SystemListLowColor}"
                                            BorderThickness="0"
                                            CornerRadius="999"
                                            IsVisible="{Binding Tokens, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <LucideIcon
                                                    Foreground="{DynamicResource SystemBaseMediumColor}"
                                                    Kind="WeightTilde"
                                                    Size="14" />
                                                <TextBlock
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SystemBaseMediumColor}"
                                                    Text="{Binding TokensText}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </views:SidePanel>

                        <!--  Knowledge Base  -->
                        <views:SidePanel
                            Header="{echoes:Translate {x:Static translations:Strings+sidepanel.knowledge_base}}"
                            IsVisible="{Binding #MemoryButton.IsChecked}">
                            <DataGrid
                                VerticalAlignment="Top"
                                AutoGenerateColumns="False"
                                Background="{DynamicResource SystemChromeHighColor}"
                                CanUserResizeColumns="True"
                                GridLinesVisibility="All"
                                IsReadOnly="True"
                                ItemsSource="{Binding KnowledgeBase}"
                                RowBackground="{DynamicResource SystemChromeMediumLowColor}"
                                RowHeight="NaN"
                                SelectedItem="{Binding SelectedKnowledgeRecord}"
                                SelectionMode="Single"
                                UseLayoutRounding="True">
                                <DataGrid.Styles>
                                    <Style Selector="DataGridRow">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem
                                                        x:DataType="vm:MainVM"
                                                        Command="{Binding DeletingRecordDialogCommand}"
                                                        DataContext="{Binding $parent[DataGrid].DataContext}"
                                                        Header="{echoes:Translate {x:Static translations:Strings+context_menu.delete}}">
                                                        <MenuItem.Icon>
                                                            <LucideIcon Kind="Trash2" Size="20" />
                                                        </MenuItem.Icon>
                                                        <MenuItem.Styles>
                                                            <Style Selector="MenuItem">
                                                                <Setter Property="Foreground" Value="Red" />
                                                            </Style>
                                                            <Style
                                                                Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                                                                <Setter Property="Foreground" Value="Red" />
                                                            </Style>
                                                            <Style
                                                                Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
                                                                <Setter Property="Background">
                                                                    <SolidColorBrush Opacity="0.15" Color="Red" />
                                                                </Setter>
                                                            </Style>
                                                        </MenuItem.Styles>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style Selector="DataGridRow:nth-child(even)">
                                        <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
                                    </Style>
                                    <Style Selector="DataGridRow:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource SystemListLowColor}" />
                                    </Style>
                                    <Style Selector="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="10,0,2,0" />
                                    </Style>
                                    <Style Selector="DataGridColumnHeader TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGrid.Styles>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn
                                        Width="32"
                                        CanUserResize="False"
                                        SortMemberPath="IsFavorite">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                    Margin="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Command="{Binding $parent[DataGrid].((vm:MainVM)DataContext).ToggleFavoriteFactCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsChecked="{Binding IsFavorite, Mode=TwoWay}">
                                                    <LucideIcon Kind="Star" Size="18" />
                                                    <ToggleButton.Styles>
                                                        <Style
                                                            Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent" />
                                                        </Style>
                                                        <Style
                                                            Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SystemBaseMediumColor}" />
                                                        </Style>
                                                        <Style
                                                            Selector="ToggleButton:unchecked:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SystemBaseMediumLowColor}" />
                                                        </Style>
                                                        <Style
                                                            Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SystemAccentColor}" />
                                                        </Style>
                                                    </ToggleButton.Styles>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn
                                        Width="2*"
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+knowledge_base_panel.fact}}"
                                        SortMemberPath="Key">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0"
                                                    Padding="10,6"
                                                    VerticalAlignment="Top"
                                                    FontSize="14"
                                                    LineHeight="20"
                                                    Text="{Binding Key}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="2*"
                                                            Header="{echoes:Translate {x:Static translations:Strings+sidepanel+knowledge_base_panel.attitude}}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0"
                                                    Padding="10,6"
                                                    VerticalAlignment="Top"
                                                    FontSize="14"
                                                    LineHeight="20"
                                                    LineSpacing="0"
                                                    MaxLines="5"
                                                    Text="{Binding Value}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="WrapWithOverflow" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn
                                        Width="2*"
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+knowledge_base_panel.category}}"
                                        SortMemberPath="Category">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0"
                                                    Padding="10,6"
                                                    VerticalAlignment="Top"
                                                    FontSize="14"
                                                    LineHeight="20"
                                                    Text="{Binding Category}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </views:SidePanel>

                        <!--  Personality  -->
                        <views:SidePanel
                            Header="{echoes:Translate {x:Static translations:Strings+sidepanel.personality}}"
                            IsVisible="{Binding #PersonalityButton.IsChecked}">
                            <ScrollViewer>
                                <StackPanel
                                    MaxWidth="720"
                                    Margin="16,8"
                                    x:DataType="vm:SettingsVM"
                                    DataContext="{x:Static vm:SettingsVM.Instance}"
                                    Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="DemiBold"
                                        Text="{echoes:Translate {x:Static translations:Strings+sidepanel+personality_panel.profile}}"
                                        TextTrimming="CharacterEllipsis" />
                                    <views:SideCard
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+personality_panel.name}}"
                                        Icon="{LucideIconContent User,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding WaifuName, Mode=TwoWay}" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Classes="icon-button"
                                                ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+sidepanel+personality_panel.random_name}}"
                                                ToolTip.HorizontalOffset="0"
                                                ToolTip.VerticalOffset="4"
                                                ToolTip.Placement="Bottom"
                                                Command="{Binding SetRandomNameCommand}">
                                                <LucideIcon Kind="Dices" Size="20" />
                                            </Button>
                                        </Grid>
                                    </views:SideCard>
                                    <views:SideCard
                                        Description="{echoes:Translate {x:Static translations:Strings+sidepanel+personality_panel.birthday_description}}"
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+personality_panel.birthday}}"
                                        Icon="{LucideIconContent Cake,
                                                                 Size=20}">
                                        <TextBox
                                            Width="110"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding Birthday, Mode=TwoWay}"
                                            Watermark="ГГГГ-ММ-ДД" />
                                    </views:SideCard>
                                    <TextBlock
                                        Margin="0,4,0,4"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="DemiBold"
                                        Text="{echoes:Translate {x:Static translations:Strings+sidepanel+personality_panel.archetype}}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ListBox
                                        Margin="-16,0"
                                        Padding="0"
                                        Background="Transparent"
                                        ItemsSource="{Binding Archetypes}"
                                        SelectedItem="{Binding SelectedArchetype, Mode=TwoWay}">

                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>

                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="CornerRadius" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="MaxWidth" Value="720" />
                                                <Setter Property="Tag" Value="{Binding $self.Bounds.Width}" />
                                                <Style Selector="^[Tag=720]">
                                                    <Setter Property="CornerRadius" Value="5" />
                                                </Style>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SystemChromeHighColor}" />
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource SystemListLowColor}" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="4">
                                                    <Grid>
                                                        <Button
                                                            Width="{Binding $self.Bounds.Height}"
                                                            Height="NaN"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            x:DataType="vm:MainVM"
                                                            Classes="icon-button"
                                                            Command="{Binding PromptEditorCommand}"
                                                            DataContext="{Binding $parent[views:SidePanel].DataContext}"
                                                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                                            ToolTip.Placement="Bottom"
                                                            ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+sidepanel+personality_panel.edit_prompt}}"
                                                            ToolTip.VerticalOffset="4">
                                                            <LucideIcon Kind="Pencil" Size="14" />
                                                        </Button>
                                                        <Border
                                                            Padding="8,2,6,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1"
                                                            CornerRadius="7">
                                                            <Border.Background>
                                                                <SolidColorBrush Opacity="0.2" Color="{Binding Color}" />
                                                            </Border.Background>
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="{Binding Color}" />
                                                            </Border.BorderBrush>
                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                <TextBlock Text="{Binding Name}">
                                                                    <TextBlock.Foreground>
                                                                        <SolidColorBrush Color="{Binding Color}" />
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                                <TextBlock
                                                                    MinWidth="0"
                                                                    FontFamily="Noto Color Emoji, Apple Color Emoji"
                                                                    Text="{Binding Emoji}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock
                                                        Margin="6,0"
                                                        Tag="{Binding $parent[ListBoxItem].IsSelected}"
                                                        Text="{Binding Description}"
                                                        TextWrapping="Wrap">
                                                        <TextBlock.Styles>
                                                            <Style Selector="TextBlock[Tag=False]">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SystemBaseMediumHighColor}" />
                                                            </Style>
                                                        </TextBlock.Styles>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </views:SidePanel>

                        <!--  Model Parameters  -->
                        <views:SidePanel
                            Header="{echoes:Translate {x:Static translations:Strings+sidepanel.ai_parameters}}"
                            IsVisible="{Binding #ParametersButton.IsChecked}">
                            <ScrollViewer>
                                <StackPanel
                                    MaxWidth="720"
                                    Margin="16,8"
                                    x:DataType="vm:SettingsVM"
                                    DataContext="{x:Static vm:SettingsVM.Instance}"
                                    Spacing="8">

                                    <views:SideCard
                                        Description="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.temperature_description}}"
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.temperature}}"
                                        Icon="{LucideIconContent Thermometer,
                                                                 Size=20}">
                                        <TextBox
                                            Width="64"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding Temperature, Mode=TwoWay}"
                                            Watermark="0.7" />
                                    </views:SideCard>

                                    <views:SideCard
                                        Description="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.response_length_description}}"
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.response_length}}"
                                        Icon="{LucideIconContent Ruler,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True">
                                        <StackPanel>
                                            <Slider
                                                Width="NaN"
                                                Margin="0,-11,0,-4"
                                                IsSnapToTickEnabled="True"
                                                Maximum="4"
                                                Minimum="0"
                                                SmallChange="1"
                                                TickFrequency="1"
                                                Value="{Binding ResponseLengthValue, Mode=TwoWay}" />
                                            <Grid ColumnDefinitions="16,*,16,*,16">
                                                <Border
                                                    Width="1"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SystemBaseLowColor}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Width="1"
                                                    Height="10"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SystemBaseLowColor}" />
                                                <Border
                                                    Grid.Column="2"
                                                    Width="1"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SystemBaseLowColor}" />
                                                <Border
                                                    Grid.Column="3"
                                                    Width="1"
                                                    Height="10"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SystemBaseLowColor}" />
                                                <Border
                                                    Grid.Column="4"
                                                    Width="1"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SystemBaseLowColor}" />
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock
                                                    HorizontalAlignment="Left"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SystemBaseMediumColor}"
                                                    Text="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.response_short}}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SystemBaseMediumColor}"
                                                    Text="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.medium}}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SystemBaseMediumColor}"
                                                    Text="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.response_long}}" />
                                            </Grid>
                                        </StackPanel>
                                    </views:SideCard>

                                    <views:SideCard
                                        Description="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.max_response_length_description}}"
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.max_response_length}}"
                                        Icon="{LucideIconContent OctagonMinus,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True">
                                        <TextBox Text="{Binding MaxTokens, Mode=TwoWay}" />
                                    </views:SideCard>

                                    <views:SideCard
                                        Description="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.context_length_description}}"
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+ai_parameters_panel.context_length}}"
                                        Icon="{LucideIconContent RulerDimensionLine,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True">
                                        <TextBox Text="{Binding ContextLength, Mode=TwoWay}" />
                                    </views:SideCard>

                                </StackPanel>
                            </ScrollViewer>
                        </views:SidePanel>

                        <!--  Model Source  -->
                        <views:SidePanel
                            Header="{echoes:Translate {x:Static translations:Strings+sidepanel.model_source}}"
                            IsVisible="{Binding #ModelButton.IsChecked}">
                            <ScrollViewer>
                                <StackPanel
                                    MaxWidth="720"
                                    Margin="16,8"
                                    x:DataType="vm:SettingsVM"
                                    DataContext="{x:Static vm:SettingsVM.Instance}"
                                    Spacing="8">
                                    <RadioButton
                                        x:Name="ServerButton"
                                        GroupName="ModelSource"
                                        IsChecked="{Binding IsServerQuery}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="DemiBold"
                                            Text="{echoes:Translate {x:Static translations:Strings+sidepanel+model_source_panel.server}}"
                                            TextTrimming="CharacterEllipsis" />
                                    </RadioButton>
                                    <views:SideCard
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+model_source_panel.port}}"
                                        Icon="{LucideIconContent Hash,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True"
                                        IsEnabled="{Binding IsServerQuery}">
                                        <TextBox Text="{Binding Port, Mode=TwoWay}" />
                                    </views:SideCard>
                                    <views:SideCard
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+model_source_panel.ip}}"
                                        Icon="{LucideIconContent Network,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True"
                                        IsEnabled="{Binding IsServerQuery}">
                                        <TextBox Text="{Binding IpAddress, Mode=TwoWay}" />
                                    </views:SideCard>
                                    <RadioButton
                                        x:Name="ProviderButton"
                                        GroupName="ModelSource"
                                        IsChecked="{Binding !IsServerQuery}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="DemiBold"
                                            Text="{echoes:Translate {x:Static translations:Strings+sidepanel+model_source_panel.provider}}" />
                                    </RadioButton>
                                    <views:SideCard
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+model_source_panel.api_key}}"
                                        Icon="{LucideIconContent KeyRound,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True"
                                        IsEnabled="{Binding !IsServerQuery}">
                                        <TextBox Text="{Binding ApiKey, Mode=TwoWay}" />
                                    </views:SideCard>
                                    <views:SideCard
                                        Header="API URL"
                                        Icon="{LucideIconContent Link,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True"
                                        IsEnabled="{Binding !IsServerQuery}">
                                        <TextBox Text="{Binding ApiUrl, Mode=TwoWay}" />
                                    </views:SideCard>
                                    <views:SideCard
                                        Header="{echoes:Translate {x:Static translations:Strings+sidepanel+model_source_panel.model}}"
                                        Icon="{LucideIconContent Bot,
                                                                 Size=16,
                                                                 StrokeWidth=2}"
                                        IsBigTextBox="True"
                                        IsEnabled="{Binding !IsServerQuery}">
                                        <TextBox Text="{Binding AiModel, Mode=TwoWay}" />
                                    </views:SideCard>
                                </StackPanel>
                            </ScrollViewer>
                        </views:SidePanel>

                    </Panel>
                </Border>


                <GridSplitter
                    Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    DragCompleted="LeftThumb_OnDragCompleted">
                    <GridSplitter.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding ElementName="ChatButton" Path="IsChecked" />
                            <Binding ElementName="MemoryButton" Path="IsChecked" />
                            <Binding ElementName="PersonalityButton" Path="IsChecked" />
                            <Binding ElementName="ParametersButton" Path="IsChecked" />
                            <Binding ElementName="ModelButton" Path="IsChecked" />
                        </MultiBinding>
                    </GridSplitter.IsVisible>
                </GridSplitter>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Source={x:Static vm:SettingsVM.Instance}, Path=IsModel3DLoading}"
                    Spacing="4">
                    <Arc
                        Width="36"
                        Height="36"
                        Classes="loading"
                        Opacity="0.4"
                        StartAngle="0"
                        Stroke="{Binding $parent[Window].Foreground}"
                        StrokeLineCap="Round"
                        StrokeThickness="2"
                        SweepAngle="270">
                        <Arc.Transitions>
                            <Transitions>
                                <DoubleTransition Property="RotateTransform.Angle" Duration="0:0:1" />
                            </Transitions>
                        </Arc.Transitions>
                        <Arc.RenderTransform>
                            <RotateTransform />
                        </Arc.RenderTransform>
                    </Arc>
                </StackPanel>

                <Image x:Name="WebViewSnapshot" Grid.Column="2">
                    <Image.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="IsSettingsOpen" />
                            <Binding Path="IsPromptEditorOpen" />
                            <Binding Path="IsDeletingMessageDialogOpen" />
                            <Binding Path="IsDeletingRecordDialogOpen" />
                        </MultiBinding>
                    </Image.IsVisible>
                </Image>
                <wv:WebView
                    x:Name="MyWebView"
                    Grid.Column="2"
                    Address="{Binding WebAddress}"
                    DisableBuiltinContextMenus="True"
                    JavascriptContextCreated="MyWebView_JavascriptContextCreated">
                    <wv:WebView.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsModel3DLoading" Source="{x:Static vm:SettingsVM.Instance}" />
                            <Binding Path="!IsSettingsOpen" />
                            <Binding Path="!IsPromptEditorOpen" />
                            <Binding Path="!IsDeletingMessageDialogOpen" />
                            <Binding Path="!IsDeletingRecordDialogOpen" />
                        </MultiBinding>
                    </wv:WebView.IsVisible>
                </wv:WebView>


                <!--  RightPanel  -->
                <!-- <Border
                    Grid.Column="3"
                    x:DataType="vm:SettingsVM"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderThickness="1,0,0,0"
                    DataContext="{x:Static vm:SettingsVM.Instance}">
                    <Border.Styles>
                        <Style Selector="TextBox">
                            <Setter Property="CornerRadius" Value="5" />
                            <Setter Property="FontFamily"
                                    Value="{Binding SelectedMonoFontFamily, Source={x:Static vm:SettingsVM.Instance}}" />
                        </Style>
                        <Style Selector="StackPanel[Tag=False]">
                            <Setter Property="IsEnabled" Value="False" />
                        </Style>
                    </Border.Styles>
                    <Panel>



                    </Panel>
                </Border>-->


                <!-- <GridSplitter
                    Grid.Column="3"
                    Width="4"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    DragCompleted="RightThumb_OnDragCompleted">
                    <GridSplitter.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding ElementName="ModelButton" Path="IsChecked" />
                            <Binding ElementName="ParametersButton" Path="IsChecked" />
                        </MultiBinding>
                    </GridSplitter.IsVisible>
                </GridSplitter>-->
                <!-- <Border
                    Grid.Column="4"
                    Background="{DynamicResource SystemChromeMediumColor}"
                    BorderThickness="1,0,0,0">
                    <StackPanel
                        Margin="5"
                        HorizontalAlignment="Center"
                        Spacing="4">

                    </StackPanel>
                </Border>-->
            </Grid>
        </Grid>


        <!--  Popups  -->
        <Grid>
            <Grid.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="IsSettingsOpen" />
                    <Binding Path="IsPromptEditorOpen" />
                    <Binding Path="IsDeletingMessageDialogOpen" />
                    <Binding Path="IsDeletingRecordDialogOpen" />
                </MultiBinding>
            </Grid.IsVisible>

            <!--  Tinting  -->
            <Border Background="Black" Opacity="0.15" />

            <!--  Settings  -->
            <Border
                x:Name="SettingsPopup"
                MaxWidth="1400"
                MaxHeight="900"
                Margin="52"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsSettingsOpen}">
                <Border.Styles>
                    <Style Selector="Separator">
                        <Setter Property="Height" Value="1" />
                        <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}" />
                        <Setter Property="Margin" Value="0,18,0,18" />
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">

                    <Border
                        x:Name="FakeBorder"
                        Grid.RowSpan="2"
                        Grid.ColumnSpan="2"
                        MaxWidth="{StaticResource SettingsPopupEdgeWidth}" />

                    <LucideIcon
                        Grid.Row="0"
                        Grid.Column="0"
                        Height="48"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding #FakeBorder.Bounds.Width, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={StaticResource SettingsPopupEdgeWidth}}"
                        Kind="Settings"
                        Size="24"
                        StrokeWidth="2.25" />
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Height="48"
                        Margin="16,0"
                        IsVisible="{Binding #FakeBorder.Bounds.Width, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={StaticResource SettingsPopupEdgeWidth}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="DemiBold"
                            Text="{echoes:Translate {x:Static translations:Strings.settings}}" />
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="10,0,10,10"
                        Background="Transparent"
                        Classes.mini-style="{Binding #FakeBorder.Bounds.Width, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={StaticResource SettingsPopupEdgeWidth}}">
                        <ListBox.Styles>
                            <Style Selector="ListBox">
                                <Setter Property="Margin" Value="0,0,-10,0" />
                            </Style>
                            <Style Selector="ListBox.mini-style">
                                <Setter Property="Width" Value="56" />
                                <Setter Property="Padding" Value="10,0,0,10" />
                            </Style>
                            <Style Selector="ListBoxItem">
                                <Setter Property="CornerRadius" Value="4" />
                                <Setter Property="Padding" Value="8,4,24,4" />
                                <Setter Property="Margin" Value="1" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBoxItem x:Name="General" IsSelected="True">
                            <Grid ColumnDefinitions="Auto,*">
                                <LucideIcon Kind="Wrench" Size="18" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup.general}}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem x:Name="Sound">
                            <Grid ColumnDefinitions="Auto,*">
                                <LucideIcon Kind="Volume2" Size="18" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup.audio}}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem x:Name="ModelAppearence">
                            <Grid ColumnDefinitions="Auto,*">
                                <LucideIcon Kind="Shirt" Size="18" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup.appearance}}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem x:Name="About">
                            <Grid ColumnDefinitions="Auto,*">
                                <LucideIcon Kind="Info" Size="18" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup.about}}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                    <ScrollViewer
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        x:DataType="vm:SettingsVM"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1,0,0,0"
                        DataContext="{x:Static vm:SettingsVM.Instance}">
                        <Grid>
                            <Grid.Resources>
                                <ControlTheme x:Key="SettingsGroup" TargetType="Border">
                                    <Setter Property="Margin" Value="12" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Padding" Value="18" />
                                    <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
                                </ControlTheme>
                            </Grid.Resources>
                            <Grid.Styles>
                                <Style Selector="Slider">
                                    <Setter Property="Width" Value="120" />
                                    <Setter Property="TickFrequency" Value="0.1" />
                                    <Setter Property="IsSnapToTickEnabled" Value="True" />
                                </Style>
                            </Grid.Styles>

                            <StackPanel Margin="24,12" IsVisible="{Binding #General.IsSelected}">
                                <TextBlock
                                    Margin="24,6,0,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.app_design}}" />
                                <Border Theme="{DynamicResource SettingsGroup}">
                                    <StackPanel>
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.theme_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.theme}}"
                                            Icon="{LucideIconContent SunMoon,
                                                                     20}">
                                            <ComboBox
                                                ItemsSource="{Binding ThemeVariants}"
                                                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Classes.dark="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ThemeVariant.Dark}}"
                                                            Classes.light="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ThemeVariant.Light}}"
                                                            Classes.system="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:ThemeVariant.System}}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.dark">
                                                                    <Setter Property="Text"
                                                                            Value="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.dark}}" />
                                                                </Style>
                                                                <Style Selector="TextBlock.light">
                                                                    <Setter Property="Text"
                                                                            Value="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.light}}" />
                                                                </Style>
                                                                <Style Selector="TextBlock.system">
                                                                    <Setter Property="Text"
                                                                            Value="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.system}}" />
                                                                </Style>
                                                            </TextBlock.Styles>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.accent_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.accent}}"
                                            Icon="{LucideIconContent Pipette,
                                                                     20}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock VerticalAlignment="Center" Text="HEX:" />
                                                <TextBox
                                                    Width="90"
                                                    Padding="6,0,6,0"
                                                    VerticalContentAlignment="Center"
                                                    Text="{Binding SelectedColor, Mode=TwoWay}"
                                                    Watermark="#RRGGBB" />
                                                <Border
                                                    Width="24"
                                                    Height="24"
                                                    Background="{DynamicResource SystemAccentColor}"
                                                    BorderBrush="{DynamicResource SystemAccentColorDark1}"
                                                    BorderThickness="1"
                                                    CornerRadius="12" />
                                            </StackPanel>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.font_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.font}}"
                                            Icon="{LucideIconContent Type,
                                                                     20}">
                                            <ComboBox ItemsSource="{Binding Fonts}"
                                                      SelectedItem="{Binding SelectedFont, Mode=TwoWay}">
                                                <Interaction.Behaviors>
                                                    <EventTriggerBehavior EventName="DropDownOpened">
                                                        <InvokeCommandAction Command="{Binding RefreshFontsCommand}" />
                                                    </EventTriggerBehavior>
                                                </Interaction.Behaviors>
                                            </ComboBox>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.monospace_font_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.monospace_font}}"
                                            Icon="{LucideIconContent SquareTerminal,
                                                                     20}">
                                            <ComboBox ItemsSource="{Binding MonospaceFonts}"
                                                      SelectedItem="{Binding SelectedMonoFont, Mode=TwoWay}">
                                                <Interaction.Behaviors>
                                                    <EventTriggerBehavior EventName="DropDownOpened">
                                                        <InvokeCommandAction
                                                            Command="{Binding RefreshMonoFontsCommand}" />
                                                    </EventTriggerBehavior>
                                                </Interaction.Behaviors>
                                            </ComboBox>
                                        </views:SettingsCard>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Margin="24,0,0,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.language}}" />
                                <Border Theme="{DynamicResource SettingsGroup}">
                                    <StackPanel>
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.ui_language_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.ui_language}}"
                                            Icon="{LucideIconContent Globe,
                                                                     20}">
                                            <ComboBox ItemsSource="{Binding AppLanguages}"
                                                      SelectedItem="{Binding SelectedAppLanguage}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Text="{Binding Converter={StaticResource StringValueConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.ai_language_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+general_panel.ai_language}}"
                                            Icon="{LucideIconContent Languages,
                                                                     20}">
                                            <ComboBox ItemsSource="{Binding Languages}"
                                                      SelectedItem="{Binding SelectedLanguage}">
                                                <ComboBox.IsEnabled>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="!IsSpeakersLoading" />
                                                        <Binding Path="!IsDownloading" />
                                                    </MultiBinding>
                                                </ComboBox.IsEnabled>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Text="{Binding Converter={StaticResource StringValueConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </views:SettingsCard>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="24,12" IsVisible="{Binding #Sound.IsSelected}">
                                <TextBlock
                                    Margin="24,6,0,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.provider}}" />
                                <Border Theme="{DynamicResource SettingsGroup}">
                                    <StackPanel>
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.provider_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.provider}}"
                                            Icon="{LucideIconContent Cpu,
                                                                     20}">
                                            <ComboBox ItemsSource="{Binding Sources}"
                                                      SelectedItem="{Binding SelectedSource}">
                                                <ComboBox.IsEnabled>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="!IsSpeakersLoading" />
                                                        <Binding Path="!IsDownloading" />
                                                    </MultiBinding>
                                                </ComboBox.IsEnabled>
                                            </ComboBox>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.model_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.model}}"
                                            Icon="{LucideIconContent Bot,
                                                                     20}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsDownloading}"
                                                    Spacing="2">
                                                    <Grid>
                                                        <TextBlock
                                                            FontFamily="{Binding SelectedMonoFontFamily}"
                                                            FontSize="12"
                                                            Text="{Binding DownloadSpeed, StringFormat={}{0} MB/s}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontFamily="{Binding SelectedMonoFontFamily}"
                                                            FontSize="12"
                                                            Text="{Binding DownloadProgress, StringFormat={}{0}%}" />
                                                    </Grid>
                                                    <ProgressBar MinWidth="160" Value="{Binding DownloadProgress}" />
                                                </StackPanel>
                                                <Button Classes="icon-button"
                                                        Command="{Binding DownloadVoiceModelCommand}">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!IsSelectedVoiceModelLoaded" />
                                                            <Binding Path="!IsDownloading" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                    <LucideIcon Kind="Download" Size="20" />
                                                </Button>
                                                <Button
                                                    Classes="icon-button"
                                                    Command="{Binding CancelDownloadCommand}"
                                                    IsVisible="{Binding IsDownloading}">
                                                    <LucideIcon Kind="CircleX" Size="18" />
                                                </Button>
                                                <ComboBox ItemsSource="{Binding Models}"
                                                          SelectedItem="{Binding SelectedVoiceModel}">
                                                    <ComboBox.IsEnabled>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!IsSpeakersLoading" />
                                                            <Binding Path="!IsDownloading" />
                                                        </MultiBinding>
                                                    </ComboBox.IsEnabled>
                                                </ComboBox>
                                            </StackPanel>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.speaker_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.speaker}}"
                                            Icon="{LucideIconContent Speech,
                                                                     20}">
                                            <Grid>

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <StackPanel.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!IsSpeakersLoading" />
                                                            <Binding Path="IsSelectedVoiceModelLoaded" />
                                                        </MultiBinding>
                                                    </StackPanel.IsVisible>
                                                    <Button
                                                        Classes="icon-button"
                                                        ToolTip.Tip="{echoes:Translate {x:Static translations:Strings+loading.test}}"
                                                        ToolTip.VerticalOffset="4"
                                                        ToolTip.HorizontalOffset="0"
                                                        ToolTip.Placement="Bottom"
                                                        Command="{Binding #RootPanel.((vm:MainVM)DataContext).RequestTestCommand}">
                                                        <LucideIcon
                                                            Kind="Play"
                                                            Size="20" />
                                                    </Button>
                                                    <ComboBox ItemsSource="{Binding Speakers}"
                                                              SelectedItem="{Binding SelectedSpeaker}" />
                                                </StackPanel>

                                                <Arc
                                                    Width="24"
                                                    Height="24"
                                                    Classes="loading"
                                                    IsVisible="{Binding IsSpeakersLoading}"
                                                    Opacity="0.4"
                                                    StartAngle="0"
                                                    Stroke="{Binding $parent[Window].Foreground}"
                                                    StrokeLineCap="Round"
                                                    StrokeThickness="2"
                                                    SweepAngle="270">
                                                    <Arc.RenderTransform>
                                                        <RotateTransform />
                                                    </Arc.RenderTransform>
                                                </Arc>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="DemiBold"
                                                    Text="{echoes:Translate {x:Static translations:Strings+loading.load_model}}">
                                                    <TextBlock.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!IsSpeakersLoading" />
                                                            <Binding Path="!IsSelectedVoiceModelLoaded" />
                                                        </MultiBinding>
                                                    </TextBlock.IsVisible>
                                                </TextBlock>
                                            </Grid>
                                        </views:SettingsCard>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Margin="24,0,0,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.voice}}" />
                                <Border Theme="{DynamicResource SettingsGroup}">
                                    <StackPanel>
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.volume_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.volume}}"
                                            Tag="{Binding VolumeLevel}">
                                            <views:SettingsCard.Styles>
                                                <Style Selector="views|SettingsCard[Tag=0]">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <Template>
                                                                <LucideIcon Kind="VolumeX" Size="20" />
                                                            </Template>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style Selector="views|SettingsCard[Tag=1]">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <Template>
                                                                <LucideIcon Kind="Volume" Size="20" />
                                                            </Template>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style Selector="views|SettingsCard[Tag=2]">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <Template>
                                                                <LucideIcon Kind="Volume1" Size="20" />
                                                            </Template>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                <Style Selector="views|SettingsCard[Tag=3]">
                                                    <Setter Property="Icon">
                                                        <Setter.Value>
                                                            <Template>
                                                                <LucideIcon Kind="Volume2" Size="20" />
                                                            </Template>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </views:SettingsCard.Styles>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Slider
                                                    Maximum="2.0"
                                                    Minimum="0.0"
                                                    Value="{Binding Volume, Mode=TwoWay}" />
                                                <TextBox
                                                    Width="64"
                                                    HorizontalContentAlignment="Center"
                                                    Text="{Binding Volume, Mode=TwoWay, StringFormat='{}{0:0.0}'}" />
                                            </StackPanel>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.pitch_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.pitch}}"
                                            Icon="{LucideIconContent AudioLines,
                                                                     20}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Slider
                                                    Maximum="2.0"
                                                    Minimum="0.0"
                                                    Value="{Binding Pitch, Mode=TwoWay}" />
                                                <TextBox
                                                    Width="64"
                                                    HorizontalContentAlignment="Center"
                                                    Text="{Binding Pitch, Mode=TwoWay, StringFormat='{}{0:0.0}'}" />
                                            </StackPanel>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.treble_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.treble}}"
                                            Icon="{LucideIconContent ChartNoAxesColumnIncreasing,
                                                                     20}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Slider
                                                    Maximum="10.0"
                                                    Minimum="-10.0"
                                                    Value="{Binding Treble, Mode=TwoWay}" />
                                                <TextBox
                                                    Width="64"
                                                    HorizontalContentAlignment="Center"
                                                    Text="{Binding Treble, Mode=TwoWay, StringFormat='{}{0:0.0}'}" />
                                            </StackPanel>
                                        </views:SettingsCard>
                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.bass_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.bass}}"
                                            Icon="{LucideIconContent ChartNoAxesColumnDecreasing,
                                                                     20}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Slider
                                                    Maximum="10.0"
                                                    Minimum="-10.0"
                                                    Value="{Binding Bass, Mode=TwoWay}" />
                                                <TextBox
                                                    Width="64"
                                                    HorizontalContentAlignment="Center"
                                                    Text="{Binding Bass, Mode=TwoWay, StringFormat='{}{0:0.0}'}" />
                                            </StackPanel>
                                        </views:SettingsCard>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Margin="24,0,0,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.advanced_settings}}" />
                                <Border Theme="{DynamicResource SettingsGroup}">
                                    <views:SettingsCard
                                        Description="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.stream_description}}"
                                        Header="{echoes:Translate {x:Static translations:Strings+settings_popup+audio_panel.stream}}"
                                        Icon="{LucideIconContent WavesVertical,
                                                                 20}">
                                        <ToggleSwitch
                                            IsChecked="{Binding IsStream, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </views:SettingsCard>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="24,12" IsVisible="{Binding #ModelAppearence.IsSelected}">
                                <TextBlock
                                    Margin="24,6,0,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.model}}" />
                                <Border Theme="{DynamicResource SettingsGroup}">
                                    <StackPanel>
                                        <views:SettingsCard
                                            Description="{Binding ModelDescription}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.character}}"
                                            Icon="{LucideIconContent Box,
                                                                     Size=20}">
                                            <Grid>
                                                <Button
                                                    Classes="word-button"
                                                    Command="{Binding OpenModel3DFileCommand}"
                                                    Content="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.add}}"
                                                    IsVisible="{Binding !IsModel3DLoading}" />
                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsModel3DLoading}"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Arc
                                                        Width="16"
                                                        Height="16"
                                                        Classes="loading"
                                                        StartAngle="0"
                                                        Stroke="{DynamicResource SystemAccentColor}"
                                                        StrokeJoin="Round"
                                                        StrokeLineCap="Round"
                                                        StrokeThickness="1.5"
                                                        SweepAngle="270">
                                                        <Arc.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="RotateTransform.Angle"
                                                                        Duration="0:0:1" />
                                                            </Transitions>
                                                        </Arc.Transitions>
                                                        <Arc.RenderTransform>
                                                            <RotateTransform />
                                                        </Arc.RenderTransform>
                                                    </Arc>
                                                    <TextBlock Foreground="{DynamicResource SystemAccentColor}"
                                                               Text="{echoes:Translate {x:Static translations:Strings+loading.model_changing}}" />
                                                </StackPanel>
                                            </Grid>
                                        </views:SettingsCard>
                                        <ListBox
                                            Margin="-3,8,-3,0"
                                            Background="Transparent"
                                            IsEnabled="{Binding !IsModel3DLoading}"
                                            ItemsSource="{Binding Models3D}"
                                            SelectedItem="{Binding SelectedModel3D, Mode=TwoWay}">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="Padding" Value="14,0" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="Margin" Value="3" />
                                                    <Setter Property="CornerRadius" Value="15" />
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemAccentColorLight3}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemAccentColorDark3}" />
                                                </Style>
                                                <Style
                                                    Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemAccentColorLight2}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemAccentColorDark3}" />
                                                </Style>
                                                <Style
                                                    Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemAccentColorDark3}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SystemAccentColorLight3}" />
                                                </Style>
                                                <Style
                                                    Selector="ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemListLowColor}" />
                                                </Style>
                                                <Style
                                                    Selector="ListBoxItem:disabled:selected /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemListMediumColor}" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>

                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.models_folder_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.models_folder}}"
                                            Icon="{LucideIconContent FolderClosed,
                                                                     Size=20}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border
                                                    MaxWidth="260"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemAccentColorLight3}"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        Margin="0"
                                                        Padding="6,2,6,2"
                                                        FontFamily="{Binding SelectedMonoFontFamily, Source={x:Static vm:SettingsVM.Instance}}"
                                                        Foreground="{DynamicResource SystemAccentColorDark3}"
                                                        Text="{Binding Model3DFolder}"
                                                        TextTrimming="LeadingCharacterEllipsis" />
                                                </Border>
                                                <Button
                                                    Classes="word-button"
                                                    Command="{Binding ChangeModel3DFolderCommand}"
                                                    Content="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.edit}}" />
                                            </StackPanel>
                                        </views:SettingsCard>

                                        <Separator />
                                        <views:SettingsCard
                                            Description="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.camera_description}}"
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.camera}}"
                                            Icon="{LucideIconContent ScanEye,
                                                                     Size=20}">
                                            <ComboBox
                                                ItemsSource="{Binding CameraVariants}"
                                                SelectedItem="{Binding Camera, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Classes.close="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:CameraVariant.Portrait}}"
                                                            Classes.medium="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:CameraVariant.Medium}}"
                                                            Classes.far="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:CameraVariant.Full}}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock.close">
                                                                    <Setter
                                                                        Property="Text"
                                                                        Value="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.close}}" />
                                                                </Style>
                                                                <Style Selector="TextBlock.medium">
                                                                    <Setter
                                                                        Property="Text"
                                                                        Value="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.medium}}" />
                                                                </Style>
                                                                <Style Selector="TextBlock.far">
                                                                    <Setter
                                                                        Property="Text"
                                                                        Value="{echoes:Translate {x:Static translations:Strings+settings_popup+appearance_panel.far}}" />
                                                                </Style>
                                                            </TextBlock.Styles>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </views:SettingsCard>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="24,12" IsVisible="{Binding #About.IsSelected}">
                                <TextBlock
                                    Margin="24,6,0,0"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{echoes:Translate {x:Static translations:Strings+settings_popup.about}}" />
                                <Border Theme="{DynamicResource SettingsGroup}">
                                    <StackPanel>

                                        <views:SettingsCard
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+about_panel.version}}"
                                            Icon="{LucideIconContent CodeXml,
                                                                     Size=20}">
                                            <TextBlock
                                                Text="0.1.0-beta"
                                                TextTrimming="CharacterEllipsis" />
                                        </views:SettingsCard>

                                        <Separator />

                                        <views:SettingsCard
                                            Header="{echoes:Translate {x:Static translations:Strings+settings_popup+about_panel.repo}}">
                                            <views:SettingsCard.Icon>
                                                <PathIcon
                                                    Data="M970 2301 c-305 -68 -555 -237 -727 -493 -301 -451 -241 -1056 143
                                                        -1442 115 -116 290 -228 422 -271 49 -16 55 -16 77 -1 24 16 25 20 25 135 l0
                                                        118 -88 -5 c-103 -5 -183 13 -231 54 -17 14 -50 62 -73 106 -38 74 -66 108
                                                        -144 177 -26 23 -27 24 -9 37 43 32 130 1 185 -65 96 -117 133 -148 188 -160
                                                        49 -10 94 -6 162 14 9 3 21 24 27 48 6 23 22 58 35 77 l24 35 -81 16 c-170 35
                                                        -275 96 -344 200 -64 96 -85 179 -86 334 0 146 16 206 79 288 28 36 31 47 23
                                                        68 -15 36 -11 188 5 234 13 34 20 40 47 43 45 5 129 -24 214 -72 l73 -42 64
                                                        15 c91 21 364 20 446 0 l62 -16 58 35 c77 46 175 82 224 82 39 0 39 -1 55 -52
                                                        17 -59 20 -166 5 -217 -8 -30 -6 -39 16 -68 109 -144 121 -383 29 -579 -62
                                                        -129 -193 -219 -369 -252 l-84 -16 31 -55 32 -56 3 -223 4 -223 25 -16 c23
                                                        -15 28 -15 76 2 80 27 217 101 292 158 446 334 590 933 343 1431 -145 293
                                                        -419 518 -733 602 -137 36 -395 44 -525 15z"
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="{DynamicResource SystemBaseHighColor}">
                                                    <PathIcon.RenderTransform>
                                                        <ScaleTransform ScaleY="-1" />
                                                    </PathIcon.RenderTransform>
                                                </PathIcon>
                                            </views:SettingsCard.Icon>
                                            <HyperlinkButton
                                                NavigateUri="https://github.com/altesco/WaifuAI/"
                                                Padding="0"
                                                Margin="0"
                                                MinWidth="0"
                                                MinHeight="0">
                                                <HyperlinkButton.Resources>
                                                    <Thickness x:Key="ButtonPadding">0</Thickness>
                                                    <Thickness x:Key="HyperlinkButtonPadding">0</Thickness>
                                                </HyperlinkButton.Resources>
                                                <HyperlinkButton.Styles>
                                                    <Style Selector="HyperlinkButton /template/ ContentPresenter">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="MinHeight" Value="0" />
                                                        <Setter Property="MinWidth" Value="0" />
                                                    </Style>
                                                    <Style
                                                        Selector="HyperlinkButton:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Padding" Value="0" />
                                                    </Style>
                                                    <Style
                                                        Selector="HyperlinkButton:pressed /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Padding" Value="0" />
                                                    </Style>
                                                </HyperlinkButton.Styles>
                                                <HyperlinkButton.Content>
                                                    <TextBlock Foreground="#7583ff">
                                                        <Run Text="altesco/" /><Run FontWeight="DemiBold" Text="WaifuAI" />
                                                    </TextBlock>
                                                </HyperlinkButton.Content>
                                            </HyperlinkButton>

                                        </views:SettingsCard>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="icon-button"
                        Command="{Binding SettingsCommand}">
                        <LucideIcon Kind="X" Size="18" />
                    </Button>

                </Grid>
            </Border>

            <!--  Prompt Editor  -->
            <Border
                MaxWidth="800"
                MaxHeight="500"
                Margin="52"
                Padding="16,12,16,12"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsPromptEditorOpen}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="DemiBold"
                        Text="{echoes:Translate {x:Static translations:Strings+dialogs.edit_prompt}}" />
                    <TextBox
                        Grid.Row="1"
                        Height="NaN"
                        Margin="0,12"
                        Padding="12"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        x:DataType="vm:SettingsVM"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        DataContext="{x:Static vm:SettingsVM.Instance}"
                        Text="{Binding SelectedArchetype.Prompt, Mode=TwoWay}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            Classes="word-button"
                            Command="{Binding SavePromptCommand}"
                            Content="{echoes:Translate {x:Static translations:Strings+dialogs.save}}" />
                        <Button
                            Classes="word-button"
                            Command="{Binding PromptEditorCommand}"
                            Content="{echoes:Translate {x:Static translations:Strings+dialogs.cancel}}" />
                    </StackPanel>
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="icon-button"
                        Command="{Binding PromptEditorCommand}">
                        <LucideIcon Kind="X" Size="18" />
                    </Button>
                </Grid>
            </Border>
            <!--  Deleting Message Dialog  -->
            <Border
                MaxWidth="500"
                MaxHeight="180"
                Margin="52"
                Padding="16,12,16,12"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsDeletingMessageDialogOpen}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="DemiBold"
                        Text="{echoes:Translate {x:Static translations:Strings+dialogs.deleting}}" />
                    <TextBlock
                        Grid.Row="1"
                        Padding="0,12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="16"
                        Text="{Binding DeletingDialogMessage}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="2"
                        Margin="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            Background="{DynamicResource ErrorLowColor}"
                            BorderBrush="{DynamicResource SystemErrorTextColor}"
                            Classes="word-button"
                            Command="{Binding DeleteMessageCommand}"
                            FontWeight="DemiBold"
                            Content="{echoes:Translate {x:Static translations:Strings+dialogs.delete}}"
                            Foreground="{DynamicResource SystemErrorTextColor}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
                                </Style>
                            </Button.Styles>
                        </Button>
                        <Button
                            Classes="word-button"
                            Command="{Binding DeletingMessageDialogCommand}"
                            Content="{echoes:Translate {x:Static translations:Strings+dialogs.cancel}}" />
                    </StackPanel>
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="icon-button"
                        Command="{Binding DeletingMessageDialogCommand}">
                        <LucideIcon Kind="X" Size="18" />
                    </Button>
                </Grid>
            </Border>
            <!--  Deleting KnowledgeRecord Dialog  -->
            <Border
                MaxWidth="500"
                MaxHeight="180"
                Margin="52"
                Padding="16,12,16,12"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsDeletingRecordDialogOpen}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="22"
                        FontWeight="DemiBold"
                        Text="{echoes:Translate {x:Static translations:Strings+dialogs.deleting}}" />
                    <TextBlock
                        Grid.Row="1"
                        Padding="0,12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        FontSize="16"
                        Text="{echoes:Translate {x:Static translations:Strings+dialogs.deleting_knowledge_record}}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Row="2"
                        Margin="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            Background="{DynamicResource ErrorLowColor}"
                            BorderBrush="{DynamicResource SystemErrorTextColor}"
                            Classes="word-button"
                            FontWeight="DemiBold"
                            Command="{Binding DeleteKnowledgeRecordCommand}"
                            Content="{echoes:Translate {x:Static translations:Strings+dialogs.delete}}"
                            Foreground="{DynamicResource SystemErrorTextColor}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}" />
                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorTextColor}" />
                                </Style>
                            </Button.Styles>
                        </Button>
                        <Button
                            Classes="word-button"
                            Command="{Binding DeletingRecordDialogCommand}"
                            Content="{echoes:Translate {x:Static translations:Strings+dialogs.cancel}}" />
                    </StackPanel>
                    <Button
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="icon-button"
                        Command="{Binding DeletingRecordDialogCommand}">
                        <LucideIcon Kind="X" Size="18" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <!--  Startup  -->
        <StackPanel
            VerticalAlignment="Center"
            IsVisible="{Binding IsAppInitializing, Source={x:Static vm:SettingsVM.Instance}}"
            Spacing="16">
            <TextBlock HorizontalAlignment="Center" Text="{Binding InitializingMessage}" />
            <ProgressBar
                Height="8"
                MaxWidth="1000"
                Margin="100,0"
                CornerRadius="3"
                IsIndeterminate="{Binding IsAppInitializing, Source={x:Static vm:SettingsVM.Instance}}"
                IsVisible="{Binding IsAppInitializing, Source={x:Static vm:SettingsVM.Instance}}" />
        </StackPanel>
    </Grid>
</Window>

