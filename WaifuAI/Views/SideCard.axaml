<Styles 
	xmlns="https://github.com/avaloniaui"
  	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  	xmlns:views="using:WaifuAI.Views">
	<Style Selector="views|SideCard">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
					<Grid>
						<Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !$parent[views:SideCard].IsBigTextBox}">
							<ContentPresenter 
								Grid.RowSpan="2" 
								Content="{TemplateBinding Icon}"
								VerticalAlignment="Center"
								Margin="0,0,12,0"/>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
								<TextBlock 
									Text="{TemplateBinding Header}"  
									FontSize="14" 
									FontWeight="Medium"
									TextTrimming="CharacterEllipsis"/>
								<TextBlock 
									Text="{TemplateBinding Description}" 
									FontSize="12" 
									Foreground="{DynamicResource SystemBaseMediumColor}"
									IsVisible="{TemplateBinding Description, 
									Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
									TextWrapping="Wrap"/>
							</StackPanel>
							<ContentPresenter 
								Grid.Column="2"
								Content="{TemplateBinding InnerContent}"
								VerticalAlignment="Center"
								VerticalContentAlignment="Center"
								Margin="12,0,0,0"/>
						</Grid>
						<StackPanel IsVisible="{Binding $parent[views:SideCard].IsBigTextBox}" Spacing="4">
							<Grid ColumnDefinitions="Auto,*">
								<ContentPresenter Content="{TemplateBinding Icon}"/>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="DemiBold"
                                    Text="{TemplateBinding Header}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
							<ContentPresenter Content="{TemplateBinding InnerContent}"/>
						</StackPanel>
					</Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
